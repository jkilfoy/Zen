# Dart / Flutter
.dart_tool/
.packages
build/
pubspec.lock.bak
*.iml
.flutter-plugins
.flutter-plugins-dependencies

# FVM
.fvm/

# IDE. The two shared VS Code files are committed on purpose: settings.json
# mirrors what CI enforces, and extensions.json prompts for the Dart and
# Flutter extensions. Everything else under .vscode/ is personal.
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
*.swp

# OS
Thumbs.db
.DS_Store

# Generated Drift output is committed (§11.5.3 migration tests depend on it),
# so *.g.dart is deliberately NOT ignored.

# Secrets: the Android signing keystore and its passwords (§11.9) must never
# reach the repository. Back them up off-device instead.
*.keystore
*.jks
key.properties

# Local run logs (e.g. verify.ps1 output redirected to a file).
tools/result.txt
tools/*.log
