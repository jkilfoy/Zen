-- HIST-2, §11.5.1. The append-only event log each replica keeps.
--
-- Local-only: it never travels in a snapshot (§11.6.1). It carries no foreign
-- key, because DEL-3 hard-deletes an Idea and the log must outlive it — that is
-- the point of an audit trail.
CREATE TABLE events (
  event_id TEXT NOT NULL PRIMARY KEY,
  item_id TEXT NOT NULL,
  -- ItemKind.name: 'idea' | 'task'.
  item_kind TEXT NOT NULL,
  -- ItemEventType.name.
  type TEXT NOT NULL,
  timestamp TEXT NOT NULL,
  -- HIST-2 specifies a payload without specifying its shape, and the MVP never
  -- reads it back, so it is stored as JSON.
  payload TEXT NOT NULL DEFAULT '{}',

  CONSTRAINT inv9_events_timestamp
    CHECK (length(timestamp) = 24 AND timestamp LIKE '%Z'),
  CONSTRAINT item_kind_events CHECK (item_kind IN ('idea', 'task'))
) STRICT AS EventRow;

-- `EventLog.forItem`, oldest first.
CREATE INDEX idx_events_item ON events (item_id, timestamp);

-- `EventLog.prune`: the §11.5.1 cap walks the log newest-first to find the
-- floor, then deletes what is both older than the window and below it.
CREATE INDEX idx_events_timestamp ON events (timestamp);
