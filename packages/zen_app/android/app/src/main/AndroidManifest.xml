<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- SPEC 11.6.4, 11.2. LAN sync needs no special permission at targetSdk 36:
         an app targeting SDK 36 or lower is granted local network access
         implicitly through INTERNET, and that implicit grant holds even on
         devices running Android 17.

         ACCESS_LOCAL_NETWORK becomes mandatory only at targetSdk 37 or higher,
         where mDNS, .local resolution and outgoing and incoming LAN TCP/UDP are
         all blocked by default. Raising targetSdk to 37 in build.gradle.kts is
         therefore the change that will break LAN sync, silently and completely,
         unless that permission is declared and requested at runtime or
         discovery moves to NsdManager with DiscoveryRequest.FLAG_SHOW_PICKER.
         The owner's device runs Android 13, so no manual check will ever catch
         this: it has to be reasoned about (SPEC 11.13.1). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- SPEC 11.6.4 step 2. Scanning the desktop's pairing QR code.
         `required="false"`: typing the host, port and code is a first-class
         path, not a fallback, so a device with no camera must still install. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <!-- SPEC 11.9. `allowBackup` unset defaults to TRUE, and Android Auto
         Backup then copies the database - every idea, every task, and the LAN
         pairing keys - to the user's Google Drive. That silently contradicts
         the premise the whole sync design rests on: no server, nothing leaving
         the local network (SPEC 13.1, A3). The cost is that a device transfer
         no longer carries the data, which is what LAN sync and
         "Export snapshot..." are for. Set explicitly rather than inherited. -->
    <application
        android:label="Zen"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
